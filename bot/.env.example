# ============================================================================
# OctaneRPG Bot — Environment Configuration
# ============================================================================
# Copy this to bot/.env and fill in your values.
# ============================================================================

# ============================================================================
# ENVIRONMENT
# ============================================================================
NODE_ENV=development

# ============================================================================
# DISCORD BOT
# ============================================================================
# Development (Octane Beta bot) — used when NODE_ENV != production
TOKEN_DEV=your_beta_bot_token_here
CLIENT_ID_DEV=your_beta_client_id_here

# Production (Octane bot) — used when NODE_ENV = production
TOKEN_PROD=your_prod_bot_token_here
CLIENT_ID_PROD=your_prod_client_id_here

GUILDID_DEV=your_dev_guild_id
GUILDID_SUPPORT=your_support_server_guild_id
# GUILDID=

BOT_VERSION=
BOT_INVITE_URL=
SUPPORT_INVITE_URL=
# Read-only mode. true = every command that writes player state is
# replaced by a "game moved" message and only the read views keep working. false/unset = full bot.
READONLY_MODE=false
# Landing page that links to wherever the game is playable, and the invite shown for alpha testing.
GAME_URL=https://octanerpg.com/
DISCORD_INVITE_URL=https://discord.octanerpg.com/

# Local health-check HTTP endpoint the bot process exposes
BOT_HEALTH_PORT=
BOT_HEALTH_TOKEN=

# ============================================================================
# BACKEND API
# ============================================================================
# Local dev: the backend running on your machine (OctaneAPI repo)
API_URL=http://localhost:3001
API_KEY_BOT=octane-bot-dev-key

# ============================================================================
# SUPABASE
# ============================================================================
# The bot reads from Supabase directly for data that is not routed through the API
# (leaderboards, embeds, health checks). Use a service key you control; never commit it.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key

# ============================================================================
# LOGGING / WEBHOOKS (optional — Discord webhook URLs for ops notifications)
# ============================================================================
# LOG_LEVEL=debug
# DEBUG_LOGGING_ENABLED=false
# GENERAL_WEBHOOK_URL=
# API_WEBHOOK_URL=
# ERROR_WEBHOOK_URL=
# SYSTEM_WEBHOOK_URL=

# ============================================================================
# ASSETS
# ============================================================================
# ASSET_BASE_URL=https://localhost:3001/assets
