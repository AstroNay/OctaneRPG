---
// Same as Starlight's SiteTitle, but the logo is served from the Octane CDN
// (Starlight's `logo` option only accepts local files).
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
const LOGO = 'https://cdn.octanerpg.com/OctaneLogo_128.png';
---

<a href={siteTitleHref} class="site-title sl-flex">
	<img src={LOGO} alt="" width="40" height="40" decoding="async" />
	<span translate="no">{siteTitle}</span>
</a>

<style>
	@layer starlight.core {
		.site-title {
			align-items: center;
			gap: var(--sl-nav-gap);
			font-size: var(--sl-text-h4);
			font-weight: 600;
			color: var(--sl-color-text-accent);
			text-decoration: none;
			white-space: nowrap;
			min-width: 0;
		}
		span {
			overflow: hidden;
		}
		img {
			height: calc(var(--sl-nav-height) - 2 * var(--sl-nav-pad-y));
			width: auto;
			object-fit: contain;
		}
	}
</style>
